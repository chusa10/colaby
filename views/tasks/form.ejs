<% locals.activePage = 'tasks' %>
<%- include('../layout/header') %>

<div class="page-header">
  <h2><%= task ? 'Edit Task' : 'New Task' %></h2>
</div>

<% if (locals.error) { %><p class="error"><%= error %></p><% } %>

<form method="POST" action="<%= task ? '/tasks/' + task.id : '/tasks' %>">

  <label for="title">Title</label>
  <input type="text" id="title" name="title"
         value="<%= task ? task.title : '' %>" required autofocus />

  <label for="description">Notes / Description</label>
  <textarea id="description" name="description" rows="5"><%= task ? (task.description||'') : '' %></textarea>

  <label for="assigned_to">Assigned To</label>
  <select id="assigned_to" name="assigned_to">
    <option value="">— Unassigned —</option>
    <% users.forEach(u => { %>
      <option value="<%= u.id %>" <%= task && task.assigned_to == u.id ? 'selected' : '' %>><%= u.name %></option>
    <% }) %>
  </select>

  <label for="deadline">Deadline</label>
  <input type="date" id="deadline" name="deadline"
         value="<%= task ? (task.deadline||'') : '' %>" />

  <label for="status">Status</label>
  <select id="status" name="status">
    <% ['Not Started','In Progress','Completed','Blocked'].forEach(s => { %>
      <option value="<%= s %>" <%= task && task.status === s ? 'selected' : '' %>><%= s %></option>
    <% }) %>
  </select>

  <div style="margin-top:1.5rem;">
    <button type="submit">Save</button>
    <a href="/tasks">Cancel</a>
  </div>
</form>

<%- include('../layout/footer') %>
