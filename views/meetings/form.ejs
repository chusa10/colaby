<% locals.activePage = 'meetings' %>
<%- include('../layout/header') %>
<div class="page-header">
  <h2><%= meeting ? 'Edit Meeting Minutes' : 'New Meeting Minutes' %></h2>
</div>
<form method="POST" action="<%= meeting ? '/meetings/' + meeting.id : '/meetings' %>">
  <label for="title">Meeting Title</label>
  <input type="text" id="title" name="title" value="<%= meeting ? meeting.title : '' %>" required />

  <label for="date">Date</label>
  <input type="date" id="date" name="date" value="<%= meeting ? meeting.date : '' %>" required />

  <label for="summary">Summary</label>
  <textarea id="summary" name="summary" rows="3"><%= meeting ? meeting.summary : '' %></textarea>

  <label for="minutes">Minutes / Notes</label>
  <textarea id="minutes" name="minutes" rows="8"><%= meeting ? meeting.minutes : '' %></textarea>

  <div style="margin-top:1.25rem;">
    <button type="submit">Save</button>
    <a href="/meetings">Cancel</a>
  </div>
</form>
<%- include('../layout/footer') %>
