<% locals.activePage = 'projects' %>
<%- include('../layout/header') %>

<div class="page-header">
  <h2><%= feature ? 'Edit Feature' : 'New Feature' %> — <%= epic.name %></h2>
</div>

<% if (locals.error) { %><p class="error"><%= error %></p><% } %>

<form method="POST" action="<%= feature ? '/projects/'+project.id+'/epics/'+epic.id+'/features/'+feature.id : '/projects/'+project.id+'/epics/'+epic.id+'/features' %>">

  <label for="name">Feature Name</label>
  <input type="text" id="name" name="name"
         value="<%= feature ? feature.name : '' %>" required autofocus
         placeholder='e.g. "Login with SSO"' />

  <label for="status">Status</label>
  <select id="status" name="status">
    <% ['New','Active','Resolved','Closed','Removed','Inactive'].forEach(s => { %>
      <option value="<%= s %>" <%= feature && feature.status === s ? 'selected' : '' %>><%= s %></option>
    <% }) %>
  </select>

  <label for="ado_url">Azure DevOps Link <span style="font-weight:400;color:#9ca3af;">(optional)</span></label>
  <input type="url" id="ado_url" name="ado_url"
         value="<%= feature ? (feature.ado_url||'') : '' %>"
         placeholder="https://dev.azure.com/org/project/_workitems/edit/12345" />

  <label for="this_week">This Week <span style="font-weight:400;color:#9ca3af;">(optional)</span></label>
  <textarea id="this_week" name="this_week" rows="2" placeholder="What happened this week…"><%= feature ? (feature.this_week||'') : '' %></textarea>

  <label for="next_week">Next Week <span style="font-weight:400;color:#9ca3af;">(optional)</span></label>
  <textarea id="next_week" name="next_week" rows="2" placeholder="What's planned next week…"><%= feature ? (feature.next_week||'') : '' %></textarea>

  <div style="margin-top:1.5rem;">
    <button type="submit">Save</button>
    <a href="/projects/<%= project.id %>/epics/<%= epic.id %>">Cancel</a>
  </div>
</form>

<%- include('../layout/footer') %>
