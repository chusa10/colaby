<% locals.activePage = 'projects' %>
<%- include('../layout/header') %>

<div class="page-header">
  <h2><%= feature ? 'Edit Feature' : 'New Feature' %> — <%= epic.name %></h2>
</div>

<% if (locals.error) { %><p class="error"><%= error %></p><% } %>

<form method="POST" action="<%= feature ? '/projects/'+project.id+'/epics/'+epic.id+'/features/'+feature.id : '/projects/'+project.id+'/epics/'+epic.id+'/features' %>">

  <label for="name">Feature Name</label>
  <input type="text" id="name" name="name"
         value="<%= feature ? feature.name : '' %>" required autofocus
         placeholder='e.g. "Login with SSO"' />

  <label for="start_date">Start Date <span style="font-weight:400;color:#9ca3af;">(optional)</span></label>
  <input type="date" id="start_date" name="start_date"
         value="<%= feature ? (feature.start_date||'') : '' %>" />

  <label for="end_date">End Date <span style="font-weight:400;color:#9ca3af;">(optional)</span></label>
  <input type="date" id="end_date" name="end_date"
         value="<%= feature ? (feature.end_date||'') : '' %>" />

  <div style="margin-top:1.5rem;">
    <button type="submit">Save</button>
    <a href="/projects/<%= project.id %>/epics/<%= epic.id %>">Cancel</a>
  </div>
</form>

<%- include('../layout/footer') %>
