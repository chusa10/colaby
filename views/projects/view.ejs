<% locals.activePage = 'projects' %>
<%- include('../layout/header') %>

<%
// Timeline range from epics
let minDate = null, maxDate = null;
epics.forEach(e => {
  if (e.start_date && (!minDate || e.start_date < minDate)) minDate = e.start_date;
  if (e.end_date   && (!maxDate || e.end_date   > maxDate)) maxDate = e.end_date;
});
if (!minDate) minDate = new Date().toISOString().slice(0,10);
if (!maxDate) { const d = new Date(); d.setMonth(d.getMonth()+3); maxDate = d.toISOString().slice(0,10); }

function toDays(dateStr){ const [y,m,d]=dateStr.split('-').map(Number); return Math.floor(Date.UTC(y,m-1,d)/(1000*60*60*24)); }

const startYear=parseInt(minDate.slice(0,4)), startMon=parseInt(minDate.slice(5,7))-1;
const endYear=parseInt(maxDate.slice(0,4)),   endMon=parseInt(maxDate.slice(5,7))-1;
const months=[]; let my=startYear, mm=startMon;
while (my<endYear || (my===endYear && mm<=endMon)) {
  months.push({ label: new Date(my,mm,1).toLocaleString('en',{month:'short',year:'numeric'}) });
  mm++; if (mm>11){mm=0;my++;}
}
const rangeStartDays = toDays(startYear+'-'+String(startMon+1).padStart(2,'0')+'-01');
const afterEndMon=endMon+1>11?0:endMon+1, afterEndYear=endMon+1>11?endYear+1:endYear;
const rangeEndDays = toDays(afterEndYear+'-'+String(afterEndMon+1).padStart(2,'0')+'-01');
const totalDays = rangeEndDays-rangeStartDays;
const totalPx = months.length*500;

// Status → color
function statusColor(s){
  return s==='Done'?'#10b981': s==='At Risk'?'#ef4444': s==='On Track'?'#3b82f6':'#9ca3af';
}
%>

<div class="doc-view">

  <div class="doc-view-header">
    <div class="doc-view-title-row">
      <div class="doc-view-icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
        </svg>
      </div>
      <div>
        <p class="doc-view-eyebrow">Project Roadmap</p>
        <h1 class="doc-view-title"><%= project.title %></h1>
      </div>
    </div>
    <div class="doc-view-actions">
      <a href="/projects/<%= project.id %>/epics/new" class="btn">+ Add Epic</a>
      <a href="/projects/<%= project.id %>/edit" class="btn">Edit</a>
      <form method="POST" action="/projects/<%= project.id %>/delete"
            onsubmit="return confirm('Delete this project and all its epics?')" style="display:inline;">
        <button type="submit" class="btn btn-danger">Delete</button>
      </form>
    </div>
  </div>

  <!-- ── Dashboard summary strip ── -->
  <div class="dash-strip">
    <div class="dash-card">
      <span class="dash-num"><%= summary.epicCount %></span>
      <span class="dash-label">Epics</span>
    </div>
    <div class="dash-card">
      <span class="dash-num"><%= summary.avgProgress %>%</span>
      <span class="dash-label">Avg Complete</span>
    </div>
    <div class="dash-card">
      <span class="dash-num"><%= summary.totalFeatures %></span>
      <span class="dash-label">Features</span>
    </div>
    <div class="dash-card <%= summary.atRisk > 0 ? 'dash-card--risk' : '' %>">
      <span class="dash-num"><%= summary.atRisk %></span>
      <span class="dash-label">At Risk</span>
    </div>
    <div class="dash-card dash-card--done">
      <span class="dash-num"><%= summary.done %></span>
      <span class="dash-label">Done</span>
    </div>
  </div>

  <!-- Feature status tally -->
  <% if (summary.totalFeatures > 0) { %>
  <div class="status-tally">
    <% Object.keys(summary.statusTally).forEach(st => { %>
      <span class="badge badge-<%= st.toLowerCase().replace(/ /g,'-') %>"><%= summary.statusTally[st] %> <%= st %></span>
    <% }) %>
  </div>
  <% } %>

  <!-- ── Epic Timeline ── -->
  <% if (epics.length === 0) { %>
    <div class="empty-state-box" style="margin-top:1.5rem;">
      <p>No epics yet. Add your first epic to build the roadmap.</p>
      <a href="/projects/<%= project.id %>/epics/new" class="btn" style="margin-top:1rem;">+ Add Epic</a>
    </div>
  <% } else { %>

  <h3 style="margin:1.5rem 0 0.75rem; font-size:1rem; font-weight:700;">Timeline</h3>
  <div class="gantt-container">
    <div class="gantt-scroll">
      <div class="gantt-header" style="width:<%= totalPx %>px;">
        <% months.forEach(m => { %>
          <div class="gantt-month" style="width:500px;"><%= m.label %></div>
        <% }) %>
      </div>
      <div class="gantt-body" style="width:<%= totalPx %>px; position:relative;">
        <% months.forEach((m,i)=>{ %>
          <div class="gantt-grid-line" style="left:<%= i*500 %>px;"></div>
        <% }) %>
        <% epics.forEach(e => {
          const s = e.start_date ? Math.max(toDays(e.start_date), rangeStartDays) : rangeStartDays;
          const en = e.end_date ? Math.min(toDays(e.end_date), rangeEndDays) : rangeEndDays;
          const leftPx = ((s-rangeStartDays)/totalDays)*totalPx;
          const widthPx = ((en-s)/totalDays)*totalPx;
          const col = statusColor(e.statusLabel);
        %>
        <div class="gantt-row">
          <a href="/projects/<%= project.id %>/epics/<%= e.id %>" class="gantt-bar"
             style="left:<%= leftPx %>px; width:<%= Math.max(widthPx,90) %>px; background:<%= col %>;"
             title="<%= e.name %> — <%= e.statusLabel %> (<%= e.progress %>%)">
            <div class="gantt-bar-fill" style="width:<%= e.progress %>%; background:rgba(0,0,0,0.18);"></div>
            <span class="gantt-bar-label"><%= e.name %> · <%= e.progress %>%</span>
          </a>
        </div>
        <% }) %>
      </div>
    </div>
  </div>

  <div class="gantt-legend">
    <span><span class="legend-dot" style="background:#3b82f6;"></span> On Track</span>
    <span><span class="legend-dot" style="background:#10b981;"></span> Done</span>
    <span><span class="legend-dot" style="background:#ef4444;"></span> At Risk</span>
    <span><span class="legend-dot" style="background:#9ca3af;"></span> Not Started</span>
    <span style="color:#9ca3af;font-size:0.75rem;">Click an epic to view its features</span>
  </div>

  <% } %>

  <a href="/projects" class="doc-back-link">&larr; Back to Projects</a>

</div>

<%- include('../layout/footer') %>
