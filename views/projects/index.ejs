<% locals.activePage = 'projects' %>
<%- include('../layout/header') %>

<div class="page-header">
  <h2>Projects</h2>
  <a href="/projects/new" class="btn">+ New Project</a>
</div>

<% if (projects.length === 0) { %>
  <div class="empty-state-box">
    <p>No projects yet.</p>
    <a href="/projects/new" class="btn" style="margin-top:1rem;">Create your first project</a>
  </div>
<% } else { %>

  <div class="project-grid">
    <% projects.forEach(p => { %>
      <a href="/projects/<%= p.id %>" class="project-card">
        <div class="project-card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="7" width="20" height="14" rx="2"/>
            <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
          </svg>
        </div>
        <span class="project-card-title"><%= p.title %></span>
        <span class="badge badge-<%= p.status.toLowerCase().replace(/ /g,'-') %>"><%= p.status %></span>
        <span class="project-card-features"><%= p.feature_count %> feature<%= p.feature_count !== 1 ? 's' : '' %></span>
      </a>
    <% }) %>
  </div>

<% } %>

<%- include('../layout/footer') %>
