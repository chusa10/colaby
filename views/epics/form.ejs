<% locals.activePage = 'projects' %>
<%- include('../layout/header') %>

<div class="page-header">
  <h2><%= epic ? 'Edit Epic' : 'New Epic' %> — <%= project.title %></h2>
</div>

<% if (locals.error) { %><p class="error"><%= error %></p><% } %>

<form method="POST" action="<%= epic ? '/projects/'+project.id+'/epics/'+epic.id : '/projects/'+project.id+'/epics' %>">

  <label for="name">Epic Name</label>
  <input type="text" id="name" name="name"
         value="<%= epic ? epic.name : '' %>" required autofocus
         placeholder='e.g. "User Authentication & Onboarding"' />

  <label for="start_date">Start Date</label>
  <input type="date" id="start_date" name="start_date"
         value="<%= epic ? (epic.start_date||'') : '' %>" required />

  <label for="end_date">End Date</label>
  <input type="date" id="end_date" name="end_date"
         value="<%= epic ? (epic.end_date||'') : '' %>" required />

  <div style="margin-top:1.5rem;">
    <button type="submit">Save</button>
    <a href="/projects/<%= project.id %>">Cancel</a>
  </div>
</form>

<%- include('../layout/footer') %>
